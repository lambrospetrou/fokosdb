{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "fokos-sharding-demo",
	"main": "index.ts",
	"compatibility_date": "2026-05-23",
	"assets": {
		"directory": "./public/",
		"run_worker_first": ["/api/*"],
	},
	"migrations": [
		{
			"new_sqlite_classes": ["CounterPartitionDO", "SearchPartitionDO", "PartitionDO"],
			"tag": "v1",
		},
		{
			"new_sqlite_classes": ["TransactionCoordinatorDO"],
			"tag": "v2",
		},
	],
	"durable_objects": {
		"bindings": [
			{
				"class_name": "CounterPartitionDO",
				"name": "COUNTER_PARTITION_DO",
			},
			{
				"class_name": "SearchPartitionDO",
				"name": "SEARCH_PARTITION_DO",
			},
			{
				"class_name": "PartitionDO",
				"name": "PARTITION_DO",
			},
			{
				"class_name": "TransactionCoordinatorDO",
				"name": "TRANSACTION_COORDINATOR_DO",
			},
		],
	},
	"compatibility_flags": ["nodejs_compat"],
}
