/**
 * Wrangler configuration for library development and tests.
 *
 * This worker is never deployed. It exists so that `vitest` (via
 * @cloudflare/vitest-plugin) and `wrangler types` have an entrypoint that
 * exports the library Durable Objects. The deployable example worker has its own
 * configuration in examples/http-api/wrangler.jsonc.
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "fokos-lib-dev",
	"main": "test/worker-entry.ts",
	"compatibility_date": "2026-05-23",
	"compatibility_flags": ["nodejs_compat"],
	"migrations": [
		{
			"new_sqlite_classes": [
				"FokosDBPartitionDO",
				"FokosDBTransactionCoordinatorDO",
				"FokosDBMaterializationDO",
				"PushMaterializationDO",
				"GsiMaterializationDO",
				"PushSinkDO",
				"CustomPartitionDO",
				"ControlledPartitionDO",
				"ControlledTransactionCoordinatorDO",
				"ErrorProbeDO",
				"CounterPartitionDO",
			],
			"tag": "v1",
		},
		{
			"new_sqlite_classes": ["TestTopologyAdminDO"],
			"tag": "v2",
		},
		{
			"new_sqlite_classes": ["FokosDBAutoAdminDO"],
			"tag": "v3",
		},
	],
	"durable_objects": {
		"bindings": [
			{
				"class_name": "FokosDBPartitionDO",
				"name": "PARTITION_DO",
			},
			{
				"class_name": "FokosDBTransactionCoordinatorDO",
				"name": "TRANSACTION_COORDINATOR_DO",
			},
			{
				"class_name": "FokosDBMaterializationDO",
				"name": "MATERIALIZATION_DO",
			},
			{
				"class_name": "PushMaterializationDO",
				"name": "PUSH_MATERIALIZATION_DO",
			},
			{
				"class_name": "GsiMaterializationDO",
				"name": "GSI_MATERIALIZATION_DO",
			},
			{
				"class_name": "PushSinkDO",
				"name": "PUSH_SINK_DO",
			},
			{
				"class_name": "CustomPartitionDO",
				"name": "CUSTOM_PARTITION_DO",
			},
			{
				"class_name": "ControlledPartitionDO",
				"name": "CONTROLLED_PARTITION_DO",
			},
			{
				"class_name": "ControlledTransactionCoordinatorDO",
				"name": "CONTROLLED_TRANSACTION_COORDINATOR_DO",
			},
			{
				"class_name": "ErrorProbeDO",
				"name": "ERROR_PROBE_DO",
			},
			{
				"class_name": "CounterPartitionDO",
				"name": "COUNTER_PARTITION_DO",
			},
			{
				"class_name": "TestTopologyAdminDO",
				"name": "TOPOLOGY_ADMIN_DO",
			},
			{
				"class_name": "FokosDBAutoAdminDO",
				"name": "FOKOS_ADMIN_DO",
			},
		],
	},
	"vars": {
		"FOKOS_SHOULD_FETCH_COLO_INFO": true,
	},
}
