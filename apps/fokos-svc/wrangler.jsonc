/**
 * Wrangler configuration for library development and tests.
 *
 * This worker is never deployed. It exists so that `vitest` (via
 * @cloudflare/vitest-pool-workers) and `wrangler types` have an entrypoint that
 * exports the library Durable Objects. The deployable example worker has its own
 * configuration in src/examples/http-api/wrangler.jsonc.
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "fokos-lib-dev",
	"main": "test/worker-entry.ts",
	"compatibility_date": "2026-05-23",
	"compatibility_flags": ["nodejs_compat"],
	"migrations": [
		{
			"new_sqlite_classes": ["PartitionDO", "TransactionCoordinatorDO", "CustomPartitionDO"],
			"tag": "v1",
		},
	],
	"durable_objects": {
		"bindings": [
			{
				"class_name": "PartitionDO",
				"name": "PARTITION_DO",
			},
			{
				"class_name": "TransactionCoordinatorDO",
				"name": "TRANSACTION_COORDINATOR_DO",
			},
			{
				"class_name": "CustomPartitionDO",
				"name": "CUSTOM_PARTITION_DO",
			},
		],
	},
	"vars": {
		"FOKOS_SHOULD_FETCH_COLO_INFO": true,
	},
}
